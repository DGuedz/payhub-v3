# Exemplo de arquivo de ambiente para configurar secrets do GitHub Actions
# Copie para .env.ci e preencha com seus valores reais

# Figma
FIGMA_TOKEN=figd_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Chave do arquivo Figma (extraída da URL do arquivo)
# Ex.: https://www.figma.com/file/<FILE_KEY>/...
FIGMA_FILE_KEY=UQwbW2cybw7SGzlBWHlgcr

# Vercel
VERCEL_TOKEN=vercel_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VERCEL_ORG_ID=org_xxxxxxxxxxxxxxxxxxxxxxxxx
VERCEL_PROJECT_ID=prj_xxxxxxxxxxxxxxxxxxxxxxxxx

# Opcionais
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Após preencher, execute:
#   bash scripts/setup-gh-secrets.sh .env.ci
# Isso criará os secrets no repositório GitHub.